;; Phase 4-A Evidence persistence tests.
(use "src/evidence")
(use "src/evidence-persistence")

(define db-dir (or (env-get "AFJ_DB_DIR") "/tmp/freelang-recon-phase4-db"))
(define artifact {"path" "tests/fixtures/normal.asar"
                  "sha256" "ecb750a65f36249fece1c6b2250ea2a2a2d80377ea1d7efba9869f36685e0813"})
(define location {"entry" "package.json" "offset" 0 "length" nil})
(define evidence (make_evidence "package.manifest" artifact location {"name" "recon"} "observed" []))
(define first-save (persist_evidence db-dir evidence))
(define second-save (persist_evidence db-dir evidence))
(define digest (get first-save "evidence_digest"))
(define loaded (get_evidence db-dir digest))
(define verified (verify_evidence_store db-dir))

(defn pass? [value] (= value true))
(assert (and (pass? (get first-save "ok"))
             (= (get first-save "status") "saved")) "DB_SAVE failed")
(println "DB_SAVE=PASS")
(assert (and (pass? (get second-save "ok"))
             (= (get second-save "status") "idempotent")) "IDEMPOTENCY failed")
(println "IDEMPOTENCY=PASS")
(assert (and (pass? (get loaded "ok"))
             (= (get (get loaded "record") "evidence_digest") digest)) "DB_READ failed")
(println "DB_READ=PASS")
(assert (= (get (get verified "verification") "ok") true) "HASH_INTEGRITY failed")
(println "HASH_INTEGRITY=PASS")
(println "TRANSACTION_RECOVERY=UNVERIFIED_SINGLE_APPEND_ONLY")
(define digest-file (env-get "AFJ_EVIDENCE_DIGEST_FILE"))
(if digest-file (file-write digest-file digest) nil)
